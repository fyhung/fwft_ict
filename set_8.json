      "title": "Column Reversal",
      "titleZh": "欄位倒序",
      "mission": {
        "zh": "先傳回「積分」，然後傳回「運動員名稱」。",
        "en": "Return points first, then athlete."
      },
      "table": "athletes",
      "concept": "FIELD ORDER",
      "goal": {
        "select": [
          {
            "type": "field",
            "name": "points"
          },
          {
            "type": "field",
            "name": "athlete"
          }
