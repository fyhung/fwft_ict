        "distinct": false,
        "where": [],
        "groupBy": [],
        "having": [],
        "orderBy": [],
        "limit": null
      }
    },
    {
      "id": "set_8_l04",
      "title": "Regional Signal",
      "titleZh": "區域訊號",
      "mission": {
        "zh": "顯示位於 East 的運動員，並傳回「運動員名稱」及「地區」。",
        "en": "Show records from East, returning athlete and region."
      },
      "table": "athletes",
      "concept": "WHERE =",
      "goal": {
        "select": [
          {
            "type": "field",
            "name": "athlete"
          },
          {
            "type": "field",
            "name": "region"
          }
        ],
        "distinct": false,
        "where": [
          {
            "left": {
              "type": "field",
              "name": "region"
            },
            "op": "=",
            "right": "East",
            "not": false
          }
        ],
        "groupBy": [],
        "having": [],
        "orderBy": [],
        "limit": null
      }
    },
    {
      "id": "set_8_l05",
      "title": "Quality Gate",
      "titleZh": "品質閘門",
      "mission": {
        "zh": "顯示「積分」為 80 或以上的運動員。",
        "en": "Show athlete and points where points is at least 80."
      },
      "table": "athletes",
      "concept": "COMPARISON",
      "goal": {
        "select": [
          {
            "type": "field",
            "name": "athlete"
          },
          {
            "type": "field",
            "name": "points"
          }
        ],
        "distinct": false,
        "where": [
          {
            "left": {
              "type": "field",
              "name": "points"
            },
            "op": ">=",
            "right": 80,
            "not": false
          }
        ],
        "groupBy": [],
        "having": [],
        "orderBy": [],
        "limit": null
      }
    },
    {
      "id": "set_8_l06",
      "title": "Range Window",
      "titleZh": "範圍視窗",
      "mission": {
