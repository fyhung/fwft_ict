              5,
              9
            ],
            "not": false
          }
        ],
        "groupBy": [],
        "having": [],
        "orderBy": [],
        "limit": null
      }
    },
    {
      "id": "set_8_l07",
      "title": "Category Lock",
      "titleZh": "類別鎖定",
      "mission": {
        "zh": "找出 Sprint 類別中「積分」為 80 或以上的記錄。",
        "en": "Find Sprint records with points of at least 80."
      },
      "table": "athletes",
      "concept": "AND",
      "goal": {
        "select": [
          {
            "type": "field",
            "name": "athlete"
          },
          {
            "type": "field",
            "name": "points"
          }
        ],
        "distinct": false,
        "where": [
          {
            "left": {
              "type": "field",
              "name": "sport"
            },
            "op": "=",
            "right": "Sprint",
            "not": false
          },
          {
            "join": "AND",
            "left": {
              "type": "field",
              "name": "points"
            },
            "op": ">=",
            "right": 80,
            "not": false
          }
        ],
        "groupBy": [],
        "having": [],
        "orderBy": [],
        "limit": null
      }
    },
