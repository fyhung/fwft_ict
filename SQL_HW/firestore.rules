rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isTeacher() {
      return signedIn()
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.role == "teacher";
    }

    match /progress/{uid} {
      allow read: if owns(uid) || isTeacher();
      allow create, update, delete: if owns(uid);
    }

    match /teachers/{uid} {
      allow read: if owns(uid);
      allow write: if false;
    }

    // ICT Browser Database Studio. Each user can access only projects stored
    // under their own authenticated Firebase UID.
    match /dbmsUsers/{uid}/projects/{projectId} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes <= 10 * 1024 * 1024
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 1
        && request.resource.data.chunkCount <= 16;
      allow delete: if owns(uid);

      match /chunks/{chunkId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.snapshotId is string
          && request.resource.data.index is int
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 700 * 1024;
        allow delete: if owns(uid);
      }
    }
  }
}
