  "levels":[
    {"id":"s1_l01","title":"Pokédex Names / 圖鑑名稱","mission":{"en":"Select only the NAME of every Pokémon.","zh":"只選取每隻寶可夢的 NAME。"},"table":"pokemon","concept":"SELECT","goal":{"select":[{"type":"field","name":"NAME"}],"distinct":false,"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l02","title":"Identity Scan / 身分掃描","mission":{"en":"Return ID, NAME, and TYPE in that order.","zh":"依次傳回 ID、NAME 及 TYPE。"},"table":"pokemon","concept":"MULTI SELECT","goal":{"select":[{"type":"field","name":"ID"},{"type":"field","name":"NAME"},{"type":"field","name":"TYPE"}],"distinct":false,"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l03","title":"Grass Partners / 草系夥伴","mission":{"en":"Show NAME and TYPE for Grass Pokémon.","zh":"顯示草系寶可夢的 NAME 及 TYPE。"},"table":"pokemon","concept":"WHERE =","goal":{"select":[{"type":"field","name":"NAME"},{"type":"field","name":"TYPE"}],"distinct":false,"where":[{"left":{"type":"field","name":"TYPE"},"op":"=","right":"Grass","not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l04","title":"Heavyweights / 重量級","mission":{"en":"Find Pokémon whose WT is greater than 200. Show NAME and WT.","zh":"找出 WT 大於 200 的寶可夢，顯示 NAME 及 WT。"},"table":"pokemon","concept":"COMPARISON","goal":{"select":[{"type":"field","name":"NAME"},{"type":"field","name":"WT"}],"distinct":false,"where":[{"left":{"type":"field","name":"WT"},"op":">","right":200,"not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l05","title":"Tough Defenders / 堅固防線","mission":{"en":"Show NAME and DEF for Pokémon with DEF of at least 80.","zh":"顯示 DEF 為 80 或以上的寶可夢 NAME 及 DEF。"},"table":"pokemon","concept":"COMPARISON","goal":{"select":[{"type":"field","name":"NAME"},{"type":"field","name":"DEF"}],"distinct":false,"where":[{"left":{"type":"field","name":"DEF"},"op":">=","right":80,"not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l06","title":"Compact Power / 小巧力量","mission":{"en":"Find Pokémon with HT below 10 and ATK above 48. Show NAME, HT, and ATK.","zh":"找出 HT 低於 10 且 ATK 高於 48 的寶可夢，顯示 NAME、HT 及 ATK。"},"table":"pokemon","concept":"AND","goal":{"select":[{"type":"field","name":"NAME"},{"type":"field","name":"HT"},{"type":"field","name":"ATK"}],"distinct":false,"where":[{"left":{"type":"field","name":"HT"},"op":"<","right":10,"not":false},{"join":"AND","left":{"type":"field","name":"ATK"},"op":">","right":48,"not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l07","title":"Flame or Wave / 火焰或水波","mission":{"en":"List the NAME and TYPE of Fire or Water Pokémon.","zh":"列出火系或水系寶可夢的 NAME 及 TYPE。"},"table":"pokemon","concept":"OR","goal":{"select":[{"type":"field","name":"NAME"},{"type":"field","name":"TYPE"}],"distinct":false,"where":[{"left":{"type":"field","name":"TYPE"},"op":"=","right":"Fire","not":false},{"join":"OR","left":{"type":"field","name":"TYPE"},"op":"=","right":"Water","not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l08","title":"Not Fire / 非火系","mission":{"en":"Return NAME and TYPE for every Pokémon that is not Fire type.","zh":"傳回所有非火系寶可夢的 NAME 及 TYPE。"},"table":"pokemon","concept":"NOT","goal":{"select":[{"type":"field","name":"NAME"},{"type":"field","name":"TYPE"}],"distinct":false,"where":[{"left":{"type":"field","name":"TYPE"},"op":"=","right":"Fire","not":true}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l09","title":"Evolution Range / 進化範圍","mission":{"en":"Show NAME and TOTAL when TOTAL is between 400 and 530 inclusive.","zh":"顯示 TOTAL 介乎 400 至 530（包括兩端）的寶可夢 NAME 及 TOTAL。"},"table":"pokemon","concept":"BETWEEN","extraValues":[[400,530]],"goal":{"select":[{"type":"field","name":"NAME"},{"type":"field","name":"TOTAL"}],"distinct":false,"where":[{"left":{"type":"field","name":"TOTAL"},"op":"BETWEEN","right":[400,530],"not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l10","title":"Lightest First / 最輕優先","mission":{"en":"List NAME and WT from lightest to heaviest.","zh":"按 WT 由輕至重列出 NAME 及 WT。"},"table":"pokemon","concept":"ORDER BY ASC","goal":{"select":[{"type":"field","name":"NAME"},{"type":"field","name":"WT"}],"distinct":false,"where":[],"groupBy":[],"having":[],"orderBy":[{"expr":{"type":"field","name":"WT"},"dir":"ASC"}],"limit":null}},
    {"id":"s1_l11","title":"Attack Ranking / 攻擊排名","mission":{"en":"List NAME and ATK from highest to lowest ATK.","zh":"按 ATK 由高至低列出 NAME 及 ATK。"},"table":"pokemon","concept":"ORDER BY DESC","goal":{"select":[{"type":"field","name":"NAME"},{"type":"field","name":"ATK"}],"distinct":false,"where":[],"groupBy":[],"having":[],"orderBy":[{"expr":{"type":"field","name":"ATK"},"dir":"DESC"}],"limit":null}},
    {"id":"s1_l12","title":"Top Three / 三強名單","mission":{"en":"Show the three Pokémon with the highest TOTAL. Return NAME and TOTAL.","zh":"顯示 TOTAL 最高的三隻寶可夢，傳回 NAME 及 TOTAL。"},"table":"pokemon","concept":"LIMIT","goal":{"select":[{"type":"field","name":"NAME"},{"type":"field","name":"TOTAL"}],"distinct":false,"where":[],"groupBy":[],"having":[],"orderBy":[{"expr":{"type":"field","name":"TOTAL"},"dir":"DESC"}],"limit":3}},
    {"id":"s1_l13","title":"Element Index / 屬性索引","mission":{"en":"Return each TYPE exactly once.","zh":"每種 TYPE 只傳回一次。"},"table":"pokemon","concept":"DISTINCT","goal":{"select":[{"type":"field","name":"TYPE"}],"distinct":true,"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l14","title":"Pokédex Count / 圖鑑計數","mission":{"en":"Count all Pokémon records.","zh":"計算所有寶可夢記錄的數量。"},"table":"pokemon","concept":"COUNT","goal":{"select":[{"type":"agg","fn":"COUNT","field":"*"}],"distinct":false,"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l15","title":"Combined Experience / 經驗總和","mission":{"en":"Calculate the sum of BASE_EXP for all Pokémon.","zh":"計算所有寶可夢 BASE_EXP 的總和。"},"table":"pokemon","concept":"SUM","goal":{"select":[{"type":"agg","fn":"SUM","field":"BASE_EXP"}],"distinct":false,"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l16","title":"Average Health / 平均生命值","mission":{"en":"Calculate the average HP of all Pokémon.","zh":"計算所有寶可夢的平均 HP。"},"table":"pokemon","concept":"AVG","goal":{"select":[{"type":"agg","fn":"AVG","field":"HP"}],"distinct":false,"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l17","title":"Type Census / 屬性統計","mission":{"en":"Count the Pokémon in each TYPE.","zh":"按 TYPE 分組，計算每種屬性的寶可夢數量。"},"table":"pokemon","concept":"GROUP BY","goal":{"select":[{"type":"field","name":"TYPE"},{"type":"agg","fn":"COUNT","field":"*"}],"distinct":false,"where":[],"groupBy":["TYPE"],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l18","title":"Type Strength / 屬性力量","mission":{"en":"Calculate the total ATK for each TYPE.","zh":"按 TYPE 分組，計算每種屬性的 ATK 總和。"},"table":"pokemon","concept":"GROUP + SUM","goal":{"select":[{"type":"field","name":"TYPE"},{"type":"agg","fn":"SUM","field":"ATK"}],"distinct":false,"where":[],"groupBy":["TYPE"],"having":[],"orderBy":[],"limit":null}},
    {"id":"s1_l19","title":"Durable Types / 耐久屬性","mission":{"en":"Calculate average DEF by TYPE and keep types whose average DEF is at least 70.","zh":"按 TYPE 計算平均 DEF，只保留平均 DEF 為 70 或以上的屬性。"},"table":"pokemon","concept":"HAVING","goal":{"select":[{"type":"field","name":"TYPE"},{"type":"agg","fn":"AVG","field":"DEF"}],"distinct":false,"where":[],"groupBy":["TYPE"],"having":[{"left":{"type":"agg","fn":"AVG","field":"DEF"},"op":">=","right":70,"not":false}],"orderBy":[],"limit":null}},
    {"id":"s1_l20","title":"Champion Analysis / 冠軍分析","mission":{"en":"For Pokémon with TOTAL at least 400, calculate average ATK by TYPE. Keep averages above 65 and order them highest first.","zh":"針對 TOTAL 為 400 或以上的寶可夢，按 TYPE 計算平均 ATK；只保留平均值高於 65 的屬性，並由高至低排列。"},"table":"pokemon","concept":"FINAL CIRCUIT","goal":{"select":[{"type":"field","name":"TYPE"},{"type":"agg","fn":"AVG","field":"ATK"}],"distinct":false,"where":[{"left":{"type":"field","name":"TOTAL"},"op":">=","right":400,"not":false}],"groupBy":["TYPE"],"having":[{"left":{"type":"agg","fn":"AVG","field":"ATK"},"op":">","right":65,"not":false}],"orderBy":[{"expr":{"type":"agg","fn":"AVG","field":"ATK"},"dir":"DESC"}],"limit":null}}
  ]
}
