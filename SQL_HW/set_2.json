  "levels":[
    {"id":"s2_l01","title":"Partner Names / 夥伴名稱","mission":{"en":"LEFT JOIN SW_POKE to POKEMON on SW_POKE.POKEID = POKEMON.ID. Show each SLOT and POKEMON.NAME.","zh":"以 SW_POKE.POKEID = POKEMON.ID 將 SW_POKE LEFT JOIN POKEMON，顯示每個 SLOT 及 POKEMON.NAME。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"LEFT JOIN","goal":{"select":[{"type":"field","name":"SW_POKE.SLOT"},{"type":"field","name":"POKEMON.NAME"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l02","title":"Full Slot Card / 完整儲存格","mission":{"en":"LEFT JOIN the tables and show SLOT, LEVEL, NAME, and TYPE.","zh":"LEFT JOIN 兩個資料表，顯示 SLOT、LEVEL、NAME 及 TYPE。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN SELECT","goal":{"select":[{"type":"field","name":"SW_POKE.SLOT"},{"type":"field","name":"SW_POKE.LEVEL"},{"type":"field","name":"POKEMON.NAME"},{"type":"field","name":"POKEMON.TYPE"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l03","title":"Joined Inventory / 連接總覽","mission":{"en":"LEFT JOIN the tables and select every joined column using *.","zh":"LEFT JOIN 兩個資料表，並使用 * 選取連接後的所有欄位。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"SELECT * JOIN","goal":{"select":[{"type":"field","name":"*"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l04","title":"Grass Slots / 草系儲存格","mission":{"en":"After the LEFT JOIN, show SLOT and NAME only for Grass Pokémon.","zh":"完成 LEFT JOIN 後，只顯示草系寶可夢的 SLOT 及 NAME。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN + WHERE","goal":{"select":[{"type":"field","name":"SW_POKE.SLOT"},{"type":"field","name":"POKEMON.NAME"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.TYPE"},"op":"=","right":"Grass","not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l05","title":"Experienced Partners / 高等級夥伴","mission":{"en":"Show SLOT, NAME, and LEVEL for joined records with LEVEL at least 20.","zh":"顯示 LEVEL 為 20 或以上的已連接記錄之 SLOT、NAME 及 LEVEL。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN + FILTER","goal":{"select":[{"type":"field","name":"SW_POKE.SLOT"},{"type":"field","name":"POKEMON.NAME"},{"type":"field","name":"SW_POKE.LEVEL"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"SW_POKE.LEVEL"},"op":">=","right":20,"not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l06","title":"Attack Advantage / 攻擊優勢","mission":{"en":"Show SLOT, NAME, ATK, and DEF where POKEMON.ATK is greater than POKEMON.DEF.","zh":"顯示 POKEMON.ATK 大於 POKEMON.DEF 的 SLOT、NAME、ATK 及 DEF。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"FIELD COMPARISON","goal":{"select":[{"type":"field","name":"SW_POKE.SLOT"},{"type":"field","name":"POKEMON.NAME"},{"type":"field","name":"POKEMON.ATK"},{"type":"field","name":"POKEMON.DEF"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.ATK"},"op":">","right":{"type":"field","name":"POKEMON.DEF"},"not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l07","title":"Missing Match / 找不到配對","mission":{"en":"Use the LEFT JOIN to find slots with no matching Pokémon. Show SLOT and POKEID.","zh":"使用 LEFT JOIN 找出沒有配對寶可夢的儲存格，顯示 SLOT 及 POKEID。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"LEFT JOIN NULL","goal":{"select":[{"type":"field","name":"SW_POKE.SLOT"},{"type":"field","name":"SW_POKE.POKEID"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.ID"},"op":"IS NULL","right":null,"not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l08","title":"Level Ranking / 等級排名","mission":{"en":"Show SLOT, NAME, and LEVEL ordered from highest to lowest LEVEL.","zh":"顯示 SLOT、NAME 及 LEVEL，並按 LEVEL 由高至低排列。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN + ORDER","goal":{"select":[{"type":"field","name":"SW_POKE.SLOT"},{"type":"field","name":"POKEMON.NAME"},{"type":"field","name":"SW_POKE.LEVEL"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[],"groupBy":[],"having":[],"orderBy":[{"expr":{"type":"field","name":"SW_POKE.LEVEL"},"dir":"DESC"}],"limit":null}},
    {"id":"s2_l09","title":"Fire Ranking / 火系排名","mission":{"en":"Show Fire Pokémon SLOT, NAME, and LEVEL, highest LEVEL first.","zh":"顯示火系寶可夢的 SLOT、NAME 及 LEVEL，LEVEL 最高者優先。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN FILTER ORDER","goal":{"select":[{"type":"field","name":"SW_POKE.SLOT"},{"type":"field","name":"POKEMON.NAME"},{"type":"field","name":"SW_POKE.LEVEL"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.TYPE"},"op":"=","right":"Fire","not":false}],"groupBy":[],"having":[],"orderBy":[{"expr":{"type":"field","name":"SW_POKE.LEVEL"},"dir":"DESC"}],"limit":null}},
    {"id":"s2_l10","title":"Top Three Slots / 三強儲存格","mission":{"en":"Show SLOT, NAME, and LEVEL for the three highest-level records.","zh":"顯示等級最高三筆記錄的 SLOT、NAME 及 LEVEL。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN + LIMIT","goal":{"select":[{"type":"field","name":"SW_POKE.SLOT"},{"type":"field","name":"POKEMON.NAME"},{"type":"field","name":"SW_POKE.LEVEL"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[],"groupBy":[],"having":[],"orderBy":[{"expr":{"type":"field","name":"SW_POKE.LEVEL"},"dir":"DESC"}],"limit":3}},
    {"id":"s2_l11","title":"Slot Count / 儲存格總數","mission":{"en":"After the LEFT JOIN, count every SW_POKE row using COUNT(*).","zh":"完成 LEFT JOIN 後，使用 COUNT(*) 計算所有 SW_POKE 記錄。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN + COUNT","goal":{"select":[{"type":"agg","fn":"COUNT","field":"*"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l12","title":"Matched Count / 配對總數","mission":{"en":"Count only matched Pokémon IDs using COUNT(POKEMON.ID).","zh":"使用 COUNT(POKEMON.ID) 只計算成功配對的寶可夢編號。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"COUNT NON-NULL","goal":{"select":[{"type":"agg","fn":"COUNT","field":"POKEMON.ID"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l13","title":"Average Level / 平均等級","mission":{"en":"Calculate the average SW_POKE.LEVEL after the LEFT JOIN.","zh":"完成 LEFT JOIN 後，計算 SW_POKE.LEVEL 的平均值。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN + AVG","goal":{"select":[{"type":"agg","fn":"AVG","field":"SW_POKE.LEVEL"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l14","title":"Type Census / 屬性統計","mission":{"en":"Exclude unmatched rows, then count joined records for each POKEMON.TYPE.","zh":"排除未配對記錄，再按 POKEMON.TYPE 計算已連接記錄的數量。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN + GROUP BY","goal":{"select":[{"type":"field","name":"POKEMON.TYPE"},{"type":"agg","fn":"COUNT","field":"*"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.ID"},"op":"IS NOT NULL","right":null,"not":false}],"groupBy":["POKEMON.TYPE"],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l15","title":"Type Level Average / 屬性平均等級","mission":{"en":"Exclude unmatched rows and calculate average LEVEL for each TYPE.","zh":"排除未配對記錄，並計算每種 TYPE 的平均 LEVEL。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN GROUP AVG","goal":{"select":[{"type":"field","name":"POKEMON.TYPE"},{"type":"agg","fn":"AVG","field":"SW_POKE.LEVEL"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.ID"},"op":"IS NOT NULL","right":null,"not":false}],"groupBy":["POKEMON.TYPE"],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l16","title":"Popular Types / 常見屬性","mission":{"en":"Count records by TYPE and keep groups with COUNT(*) greater than 3.","zh":"按 TYPE 計算記錄數量，只保留 COUNT(*) 大於 3 的群組。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN + HAVING","goal":{"select":[{"type":"field","name":"POKEMON.TYPE"},{"type":"agg","fn":"COUNT","field":"*"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.ID"},"op":"IS NOT NULL","right":null,"not":false}],"groupBy":["POKEMON.TYPE"],"having":[{"left":{"type":"agg","fn":"COUNT","field":"*"},"op":">","right":3,"not":false}],"orderBy":[],"limit":null}},
    {"id":"s2_l17","title":"Level Investment / 等級總和","mission":{"en":"Sum LEVEL by TYPE, exclude unmatched rows, and order the sums highest first.","zh":"排除未配對記錄，按 TYPE 計算 LEVEL 總和，並由高至低排列。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN SUM ORDER","goal":{"select":[{"type":"field","name":"POKEMON.TYPE"},{"type":"agg","fn":"SUM","field":"SW_POKE.LEVEL"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.ID"},"op":"IS NOT NULL","right":null,"not":false}],"groupBy":["POKEMON.TYPE"],"having":[],"orderBy":[{"expr":{"type":"agg","fn":"SUM","field":"SW_POKE.LEVEL"},"dir":"DESC"}],"limit":null}},
    {"id":"s2_l18","title":"Type Champions / 屬性最高等級","mission":{"en":"Show each TYPE with its maximum SW_POKE.LEVEL, excluding unmatched rows.","zh":"排除未配對記錄，顯示每種 TYPE 及其最高 SW_POKE.LEVEL。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN + MAX","goal":{"select":[{"type":"field","name":"POKEMON.TYPE"},{"type":"agg","fn":"MAX","field":"SW_POKE.LEVEL"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.ID"},"op":"IS NOT NULL","right":null,"not":false}],"groupBy":["POKEMON.TYPE"],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l19","title":"Water Training Band / 水系訓練範圍","mission":{"en":"Show Water Pokémon SLOT, NAME, and LEVEL where LEVEL is between 15 and 35 inclusive.","zh":"顯示 LEVEL 介乎 15 至 35（包括兩端）的水系寶可夢 SLOT、NAME 及 LEVEL。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"JOIN + BETWEEN","goal":{"select":[{"type":"field","name":"SW_POKE.SLOT"},{"type":"field","name":"POKEMON.NAME"},{"type":"field","name":"SW_POKE.LEVEL"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.TYPE"},"op":"=","right":"Water","not":false},{"join":"AND","left":{"type":"field","name":"SW_POKE.LEVEL"},"op":"BETWEEN","right":[15,35],"not":false}],"groupBy":[],"having":[],"orderBy":[],"limit":null}},
    {"id":"s2_l20","title":"Joined Type Analysis / 連接屬性分析","mission":{"en":"Exclude unmatched rows. Calculate average POKEMON.ATK by TYPE, keep averages above 60, and order highest first.","zh":"排除未配對記錄；按 TYPE 計算平均 POKEMON.ATK，只保留平均值高於 60 的群組，並由高至低排列。"},"table":"SW_POKE","tables":["SW_POKE","POKEMON"],"concept":"LEFT JOIN FINAL","goal":{"select":[{"type":"field","name":"POKEMON.TYPE"},{"type":"agg","fn":"AVG","field":"POKEMON.ATK"}],"distinct":false,"from":"SW_POKE","joins":[{"type":"LEFT","table":"POKEMON","on":{"left":{"type":"field","name":"SW_POKE.POKEID"},"op":"=","right":{"type":"field","name":"POKEMON.ID"},"not":false}}],"where":[{"left":{"type":"field","name":"POKEMON.ID"},"op":"IS NOT NULL","right":null,"not":false}],"groupBy":["POKEMON.TYPE"],"having":[{"left":{"type":"agg","fn":"AVG","field":"POKEMON.ATK"},"op":">","right":60,"not":false}],"orderBy":[{"expr":{"type":"agg","fn":"AVG","field":"POKEMON.ATK"},"dir":"DESC"}],"limit":null}}
  ]
