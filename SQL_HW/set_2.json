      {"ID":1,"NAME":"bulbasaur","TYPE":"Grass","HP":45,"ATK":49,"DEF":49},{"ID":2,"NAME":"ivysaur","TYPE":"Grass","HP":60,"ATK":62,"DEF":63},{"ID":3,"NAME":"venusaur","TYPE":"Grass","HP":80,"ATK":82,"DEF":83},
      {"ID":4,"NAME":"charmander","TYPE":"Fire","HP":39,"ATK":52,"DEF":43},{"ID":5,"NAME":"charmeleon","TYPE":"Fire","HP":58,"ATK":64,"DEF":58},{"ID":6,"NAME":"charizard","TYPE":"Fire","HP":78,"ATK":84,"DEF":78},
      {"ID":7,"NAME":"squirtle","TYPE":"Water","HP":44,"ATK":48,"DEF":65},{"ID":8,"NAME":"wartortle","TYPE":"Water","HP":59,"ATK":63,"DEF":80},{"ID":9,"NAME":"blastoise","TYPE":"Water","HP":79,"ATK":83,"DEF":100}
