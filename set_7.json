      "title": "Regional Signal",
      "titleZh": "區域訊號",
      "mission": {
        "zh": "顯示位於 Main 的表演者，並傳回「表演者名稱」及「舞台」。",
        "en": "Show records from Main, returning performer and stage."
      },
      "table": "performers",
      "concept": "WHERE =",
      "goal": {
        "select": [
          {
            "type": "field",
            "name": "performer"
          },
          {
            "type": "field",
            "name": "stage"
          }
